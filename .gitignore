.venv/
__pycache__/
.pytest_cache/
.streamlit/secrets.toml
data/raw/
data/interim/
*.zip
*.7z
*.gdb
*.gpkg-journal

# Trabalho de rascunho e material externo ao projeto.
*.pdf
notebooks/
/*.md
!/README.md

# Em docs/ a regra e inversa: nada entra por acidente, e o que e publicado esta
# nomeado abaixo. Assim o repositorio nao revela, pelo proprio .gitignore, quais
# documentos de trabalho existem fora dele.
docs/*
!docs/CORRECOES.md
!docs/DECISOES.md
!docs/DICIONARIO.md
!docs/FONTES.md
!docs/FORMULAS.md
!docs/LIMITES.md
!docs/METODO.md
!docs/REPRODUCAO.md
!docs/VALIDACAO.md

# Caminhos da maquina local, especificos de cada instalacao.
reconstrucao/pipeline/_paths_local.py

# Intermediarios do pipeline: regeraveis em seis minutos por roda_tudo.py.
# Ficam versionados apenas dados.json, geo.json e as duas bases municipais
# que o app consome diretamente.
reconstrucao/dados/*.csv
reconstrucao/dados/*.parquet
!reconstrucao/dados/cde_municipal.csv
!reconstrucao/dados/municipios_corrigido.csv
