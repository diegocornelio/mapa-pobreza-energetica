.venv/
__pycache__/
.pytest_cache/
.streamlit/secrets.toml
data/raw/
data/interim/
*.zip
*.7z
*.gdb
*.gpkg-journal

*.pdf
notebooks/

# Intermediarios do pipeline: regeraveis em seis minutos por roda_tudo.py.
# Ficam versionados apenas dados.json, geo.json e as duas bases municipais
# que o app consome diretamente.
reconstrucao/dados/*.csv
reconstrucao/dados/*.parquet
!reconstrucao/dados/cde_municipal.csv
!reconstrucao/dados/municipios_corrigido.csv

# Rascunho e anotacoes de trabalho na raiz ficam fora do produto.
/*.md
!/README.md

# Em docs/ a regra e inversa: o que e publicado esta nomeado abaixo,
# e nada entra por acidente.
docs/*
!docs/CORRECOES.md
!docs/DECISOES.md
!docs/DICIONARIO.md
!docs/FONTES.md
!docs/FORMULAS.md
!docs/LIMITES.md
!docs/METODO.md
!docs/REPRODUCAO.md
!docs/VALIDACAO.md
